# Paystack secret key (Dashboard > Settings > API Keys). Never put this in frontend code.
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# DataPlug API key
DATAPLUG_API_KEY=your_dataplug_api_key
# Password for the #admin orders page
ADMIN_PASSWORD=change-me-to-something-long
# Your profit: percent added on top of DataPlug prices (e.g. 5 = +5%)
MARKUP_PERCENT=5
# true = auto-refund via Paystack if DataPlug delivery fails
AUTO_REFUND=false
PORT=3000
